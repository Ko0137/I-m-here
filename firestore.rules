rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection test rule
    match /test/connection {
      allow read: if true;
    }

    // Room Rules
    match /rooms/{roomId} {
      allow read: if true;
      allow create: if isValidId(roomId) && request.resource.data.name is string && request.resource.data.name.size() <= 100;
      allow update: if isValidId(roomId);
      allow delete: if isValidId(roomId);

      // Message Rules
      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.text is string && request.resource.data.text.size() <= 2000;
        allow delete: if true;
      }

      // Member Rules
      match /members/{userId} {
        allow read: if true;
        allow write: if isValidId(userId);
      }
    }
  }
}
